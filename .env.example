# =============================================================================
# Local AI Application — Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values as needed.
# NEVER commit your .env file to version control.
# =============================================================================

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_VISION_MODEL=llama3.2-vision:11b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_REQUEST_TIMEOUT=120
OLLAMA_NUM_PARALLEL=2

# Meeting transcription
# Must be an existing absolute faster-whisper/CTranslate2 directory whose
# basename is exactly small.en. The desktop workflow never downloads ASR data.
ASR_MODEL_DIR=/absolute/path/to/small.en
ASR_MODEL_NAME=small.en
MEETING_AUDIO_QUEUE_SIZE=128
MEETING_PCM_WINDOW_MS=2000
MEETING_ENABLE_RAG=false

# Database (for SQL Agent target — the DB users query against)
SQL_DATABASE_URL=sqlite+aiosqlite:///./data/demo.db

# Application Database (internal: chat history, document metadata)
APP_DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# ChromaDB (vector store)
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=documents

# Document Upload
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./data/uploads
ALLOWED_EXTENSIONS=.pdf,.docx,.xlsx,.pptx,.csv,.html,.md,.txt,.png,.jpg,.jpeg,.tiff,.bmp

# API Server
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=info

# RAG
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.4

# SQL Agent Safety
SQL_MAX_ROWS=100
SQL_ALLOW_WRITES=false

# MCP
MCP_SERVERS_CONFIG=./mcp_servers.json

# Rate Limiting
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_LLM=10/minute
RATE_LIMIT_EMBEDDING=20/minute
RATE_LIMIT_UPLOAD=20/minute
