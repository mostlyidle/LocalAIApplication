# =============================================================================
# Local AI Application — Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values as needed.
# NEVER commit your .env file to version control.
# =============================================================================

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_VISION_MODEL=llama3.2-vision:11b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Alternatives: qwen3-embedding:0.6b or embeddinggemma. Use a NEW collection
# and re-ingest; do not reuse vectors from another model or input profile.
OLLAMA_REQUEST_TIMEOUT=120
OLLAMA_NUM_PARALLEL=2

# Meeting transcription
# faster-whisper remains the CPU default. mlx-whisper needs uv sync --extra mlx
# and an absolute MLX-format model directory containing config.json and weights.
ASR_BACKEND=faster-whisper
# With faster-whisper, the CTranslate2 directory must be named small.en.
# Neither backend downloads ASR data at runtime.
ASR_MODEL_DIR=/absolute/path/to/small.en
ASR_MODEL_NAME=small.en
MEETING_AUDIO_QUEUE_SIZE=128
MEETING_PCM_WINDOW_MS=2000
MEETING_ENABLE_RAG=false

# Database (for SQL Agent target — the DB users query against)
SQL_DATABASE_URL=sqlite+aiosqlite:///./data/demo.db

# Application Database (internal: chat history, document metadata)
APP_DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# ChromaDB (vector store)
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=documents
# Example for new embeddings: documents-qwen3-v1

# Hybrid RAG (Qdrant + local FastEmbed BM25)
QDRANT_URL=http://localhost:6333
FASTEMBED_CACHE_PATH=./data/fastembed
RAG_BM25_LANGUAGE=english

# Optional specialist integrations
# Stock research needs a Finnhub key for current quotes/news; omit to disable live lookup.
# FINNHUB_API_KEY=
MARKET_DATA_CACHE_SECONDS=60
# Local ComfyUI endpoint used by image_generation tasks.
COMFYUI_URL=http://localhost:8188
# Root directory allowed for read-only software-engineer workspace review.
AGENT_WORKSPACE_ROOT=./workspace
# Optional Grafana password for the local observability Compose profile.
# GRAFANA_ADMIN_PASSWORD=change-this-before-production

# Document Upload
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./data/uploads
ALLOWED_EXTENSIONS=.pdf,.docx,.xlsx,.pptx,.csv,.html,.md,.txt,.png,.jpg,.jpeg,.tiff,.bmp,.webp
# For scanned/complex PDFs, install uv sync --extra documents, provision models,
# then select docling. Default keeps lightweight parsing for existing installs.
PDF_PARSER=pymupdf
# DOCLING_ARTIFACTS_PATH=/absolute/path/to/docling-models

# API Server
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=info

# RAG
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.4

# SQL Agent Safety
SQL_MAX_ROWS=100
SQL_ALLOW_WRITES=false
SQL_QUERY_TIMEOUT_SECONDS=30

# MCP
MCP_SERVERS_CONFIG=./mcp_servers.json

# Rate Limiting
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_LLM=10/minute
RATE_LIMIT_EMBEDDING=20/minute
RATE_LIMIT_UPLOAD=20/minute
