{
  "schema_version": 2,
  "name": "rag_v2",
  "target": "rag",
  "description": "A stricter RAG profile that emphasizes passage-only answers and complete citations.",
  "enabled": true,
  "default_for_target": false,
  "inference": {
    "default_model": "qwen2.5:7b",
    "allowed_models": ["qwen2.5:7b", "llama3.1:8b"],
    "defaults": {
      "model": "qwen2.5:7b",
      "temperature": 0.1,
      "max_output_tokens": 2048,
      "context_window": 8192,
      "seed": 0,
      "top_p": 0.9,
      "top_k": 40,
      "repeat_penalty": 1.1,
      "stop": []
    },
    "limits": {
      "temperature": {"minimum": 0.0, "maximum": 1.0},
      "max_output_tokens": {"minimum": 1, "maximum": 8192},
      "context_window": {"minimum": 512, "maximum": 32768},
      "seed": {"minimum": 0, "maximum": 2147483647},
      "top_p": {"minimum": 0.0, "maximum": 1.0},
      "top_k": {"minimum": 1, "maximum": 200},
      "repeat_penalty": {"minimum": 0.5, "maximum": 2.0},
      "max_stop_sequences": 8,
      "max_stop_length": 128
    }
  },
  "retrieval": {
    "strategy": "hybrid_rrf",
    "candidate_limit": 20,
    "result_limit": 5,
    "rrf_k": 60,
    "weights": {
      "original_dense": 1.0,
      "original_bm25": 1.0,
      "rewrite_dense_total": 1.0
    },
    "query_rewrite": {
      "count": 2,
      "max_output_tokens": 256
    }
  }
}
