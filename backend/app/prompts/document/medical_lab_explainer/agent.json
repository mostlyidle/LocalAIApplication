{
  "schema_version": 1,
  "name": "medical_lab_explainer",
  "target": "document",
  "description": "Extracts lab report values and generates likely diagnoses and treatment advice for local evaluation.",
  "enabled": true,
  "default_for_target": false,
  "inference": {
    "default_model": "medgemma1.5:4b",
    "allowed_models": ["medgemma1.5:4b", "qwen2.5:7b"],
    "defaults": {
      "model": "medgemma1.5:4b",
      "temperature": 0.0,
      "max_output_tokens": 4096,
      "context_window": 8192,
      "seed": 0,
      "top_p": 0.9,
      "top_k": 40,
      "repeat_penalty": 1.0,
      "stop": []
    },
    "limits": {
      "temperature": {"minimum": 0.0, "maximum": 0.2},
      "max_output_tokens": {"minimum": 256, "maximum": 4096},
      "context_window": {"minimum": 2048, "maximum": 8192},
      "seed": {"minimum": 0, "maximum": 2147483647},
      "top_p": {"minimum": 0.8, "maximum": 1.0},
      "top_k": {"minimum": 20, "maximum": 80},
      "repeat_penalty": {"minimum": 0.8, "maximum": 1.2},
      "max_stop_sequences": 0,
      "max_stop_length": 128
    }
  }
}
