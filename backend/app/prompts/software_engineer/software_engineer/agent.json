{
  "schema_version": 1,
  "name": "software_engineer",
  "target": "software_engineer",
  "description": "Reviews a mounted source workspace and proposes bounded read-only code changes.",
  "enabled": true,
  "default_for_target": true,
  "inference": {
    "default_model": "qwen2.5-coder:7b",
    "allowed_models": ["qwen2.5-coder:7b", "qwen2.5-coder:14b"],
    "defaults": {
      "model": "qwen2.5-coder:7b",
      "temperature": 0.2,
      "max_output_tokens": 4096,
      "context_window": 16384,
      "seed": 0,
      "top_p": 0.9,
      "top_k": 40,
      "repeat_penalty": 1.1,
      "stop": []
    },
    "limits": {
      "temperature": {"minimum": 0.0, "maximum": 1.0},
      "max_output_tokens": {"minimum": 1, "maximum": 8192},
      "context_window": {"minimum": 512, "maximum": 32768},
      "seed": {"minimum": 0, "maximum": 2147483647},
      "top_p": {"minimum": 0.0, "maximum": 1.0},
      "top_k": {"minimum": 1, "maximum": 200},
      "repeat_penalty": {"minimum": 0.5, "maximum": 2.0},
      "max_stop_sequences": 8,
      "max_stop_length": 128
    }
  }
}
